PORT=5000

# Gemini (https://aistudio.google.com/apikey). Without a key, MoneyCall uses its
# built-in local engine, so the demo still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Capital One Nessie (http://api.nessieisreal.com). Run `npm run seed` once,
# then paste the printed customer id below.
NESSIE_API_KEY=
NESSIE_BASE_URL=http://api.nessieisreal.com
NESSIE_CUSTOMER_ID=

# MongoDB Atlas connection string. Without it, data is kept in memory.
MONGODB_URI=

# true = ignore Nessie and use the synthetic demo persona
USE_SYNTHETIC_DATA=false

# Safety cushion (USD) the forecast tries to keep in checking
SAFETY_THRESHOLD=100

# Comma-separated allowed origins, or * for any
CLIENT_ORIGIN=*
