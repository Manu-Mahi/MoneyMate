PORT=5000

# Public HTTPS origin of this API (only needed for Photon webhooks), e.g. https://api.moneycall.app
# For local dev use a tunnel: `ngrok http 5000` or `cloudflared tunnel --url http://localhost:5000`
PUBLIC_URL=

# Gemini (https://aistudio.google.com/apikey). Without a key, MoneyCall uses its
# built-in local engine, so the demo still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Capital One Nessie (https://nessieisreal.com). Paste your key, run
# `npm run seed` once, then paste the printed customer id below.
# `npm run nessie:check` verifies both.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_CUSTOMER_ID=

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Without it, data is kept in memory.
# e.g. mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/moneycall?retryWrites=true&w=majority
MONGODB_URI=

# Photon (https://app.beta.photon.codes → Settings for the project id, API keys for a key with
# project:read, project:write, platforms:read, platforms:write). Promo code: HACKWITHPHOTON.
# `npm run photon:setup -- --webhook $PUBLIC_URL --imessage +1YOURPHONE` registers the webhook
# and prints PHOTON_WEBHOOK_SECRET.
PHOTON_PROJECT_ID=
PHOTON_API_KEY=
PHOTON_WEBHOOK_SECRET=
# Phones (E.164, comma-separated) that get a shared iMessage line at startup. The server logs
# which number each phone should text. Each phone must send the first message.
PHOTON_PHONES=

# 4-digit PIN that confirms transfers on text and voice channels (web keeps the Confirm button).
# Three wrong PINs cancel the transfer. Leave empty to confirm with a plain YES.
TRANSFER_PIN=


# Optional shared secret required in the x-channel-secret header for POST /api/channels/message
# from external callers (give it to your ElevenLabs/Retell voice agent tool). The in-app demo
# phone (channel sms-demo) is exempt. Empty = open, fine for a local demo.
CHANNEL_SECRET=

# true = ignore Nessie and use the synthetic demo persona
USE_SYNTHETIC_DATA=false

# Safety cushion (USD) the forecast tries to keep in checking
SAFETY_THRESHOLD=100

# Comma-separated allowed origins, or * for any
CLIENT_ORIGIN=*
